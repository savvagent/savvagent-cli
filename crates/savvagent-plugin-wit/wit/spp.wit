package savvagent:plugin@0.1.0;

// SPP (Streamed Provider Protocol) types, mirrored from `savvagent-protocol`
// field-for-field. Used by the `plugin-provider` world.
//
// Reality reconciliation vs the design spec (§3): the spec sketched these
// under a separate `savvagent:spp@0.1.0` package. Keeping a second package
// alongside `savvagent:plugin@0.1.0` in the same `wit/` directory would
// force the WIT loader to walk a `deps/` subdir per the multi-package
// convention, which complicates both `wit-parser` consumption (Task 1's
// sanity test) and `wasmtime::component::bindgen!` (Task 2's host bindings).
// Inlining SPP into the `savvagent:plugin` package under a sibling `spp`
// interface keeps the directory flat, single-package, and unblocks both
// callsites; the `From`/`Into` impls between `savvagent-protocol` and the
// generated bindings land in Task 2's `spp_convert.rs` regardless of
// package shape.
//
// Task 2 reconciliation: The original sketch in Task 1 diverged from the
// real `savvagent_protocol` types in several places (e.g. an extra `system`
// role variant, a `String` `tool-result` content, a `count-tokens` pair that
// has no Rust counterpart, an inaccurate `provider-error` variant where the
// real type is a struct with `kind`). This file now mirrors the actual
// `savvagent_protocol` shapes verbatim. Where a WIT-only helper type is
// required by the plugin-provider world (e.g. `provider-manifest` returned
// by `init`), it stays here but has no Rust counterpart and therefore no
// `From`/`Into` impl in `spp_convert.rs`.
interface spp {
    // ---- CompleteRequest --------------------------------------------
    record complete-request {
        model: string,
        messages: list<message>,
        system: option<string>,
        tools: list<tool-def>,
        temperature: option<f32>,
        top-p: option<f32>,
        max-tokens: u32,
        stop-sequences: list<string>,
        %stream: bool,
        thinking: option<thinking-config>,
        // Free-form JSON metadata: `None` when absent, `Some(serialized)`
        // when present. Carried as a string so we don't drag a JSON-Value
        // type into WIT.
        metadata-json: option<string>,
    }

    record message {
        role: role,
        content: list<content-block>,
    }

    // SPP `Role` only contains `user` and `assistant`. System instructions
    // are carried in `complete-request.system`, not as a role variant.
    variant role { user, assistant }

    record thinking-config {
        budget-tokens: u32,
    }

    // ---- ContentBlock -----------------------------------------------
    variant content-block {
        text(text-block),
        tool-use(tool-use-block),
        tool-result(tool-result-block),
        image(image-block),
        thinking(thinking-block),
    }

    record text-block {
        text: string,
    }

    record tool-use-block {
        id: string,
        name: string,
        // Serialized `serde_json::Value` (always a JSON object at the top
        // level; may be `{}`).
        input-json: string,
    }

    record tool-result-block {
        tool-use-id: string,
        // SPP `tool_result.content` is a nested list of content blocks. WIT
        // does not permit recursive type definitions (content-block →
        // tool-result-block → content-block), so we carry the nested
        // content as a serialized JSON array of `ContentBlock` here. The
        // From/Into impls in `spp_convert.rs` round-trip it through
        // `serde_json`.
        content-json: string,
        is-error: bool,
    }

    record image-block {
        source: image-source,
    }

    variant image-source {
        base64(image-base64),
        url(string),
    }

    record image-base64 {
        media-type: media-type,
        // Base64-encoded bytes (no `data:` URI prefix).
        data: string,
    }

    enum media-type {
        jpeg,
        png,
        gif,
        webp,
    }

    record thinking-block {
        text: string,
        signature: option<string>,
    }

    // ---- ToolDef ----------------------------------------------------
    record tool-def {
        name: string,
        description: string,
        // Serialized JSON Schema (Draft 2020-12).
        input-schema-json: string,
    }

    // ---- CompleteResponse -------------------------------------------
    record complete-response {
        id: string,
        model: string,
        content: list<content-block>,
        stop-reason: stop-reason,
        stop-sequence: option<string>,
        usage: usage,
    }

    enum stop-reason {
        end-turn,
        tool-use,
        max-tokens,
        stop-sequence,
        refusal,
        other,
    }

    record usage {
        input-tokens: u32,
        output-tokens: u32,
        cache-creation-input-tokens: option<u32>,
        cache-read-input-tokens: option<u32>,
    }

    // ---- Streaming events ------------------------------------------
    variant stream-event {
        message-start(message-start-evt),
        content-block-start(content-block-start-evt),
        content-block-delta(content-block-delta-evt),
        content-block-stop(u32),
        message-delta(message-delta-evt),
        message-stop,
        ping,
        warning(string),
    }

    record message-start-evt {
        id: string,
        model: string,
        usage: usage,
    }

    record content-block-start-evt {
        index: u32,
        block: content-block,
    }

    record content-block-delta-evt {
        index: u32,
        delta: block-delta,
    }

    variant block-delta {
        text-delta(string),
        input-json-delta(string),
        thinking-delta(string),
        signature-delta(string),
    }

    record message-delta-evt {
        stop-reason: option<stop-reason>,
        stop-sequence: option<string>,
        usage-delta: usage-delta,
    }

    record usage-delta {
        output-tokens: option<u32>,
        cache-read-input-tokens: option<u32>,
    }

    // ---- Models discovery -------------------------------------------
    record model-info {
        id: string,
        display-name: option<string>,
        context-window: option<u64>,
    }

    record list-models-response {
        models: list<model-info>,
        default-model-id: option<string>,
    }

    // ---- Provider error --------------------------------------------
    record provider-error {
        kind: error-kind,
        message: string,
        retry-after-ms: option<u64>,
        provider-code: option<string>,
    }

    enum error-kind {
        invalid-request,
        authentication,
        permission-denied,
        model-not-found,
        context-length-exceeded,
        rate-limited,
        overloaded,
        refusal,
        network,
        not-implemented,
        internal,
    }

    // ---- Plugin-WIT-only types --------------------------------------
    //
    // The following types exist for the `plugin-provider` world contract
    // but have NO counterpart in `savvagent-protocol`. They are not part
    // of SPP-the-wire-protocol; they describe what an external provider
    // plugin returns from its `init`/`count-tokens` exports so the host
    // can register it. No `From`/`Into` impls in `spp_convert.rs`.

    record provider-manifest {
        provider-id: string,
        models: list<model-info>,
        default-model: option<string>,
    }

    record count-tokens-request {
        model: string,
        messages: list<message>,
    }

    record count-tokens-response {
        input-tokens: u32,
    }
}
